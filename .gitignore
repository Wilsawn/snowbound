.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
# data never goes in the repo; it lives in ~/snowbound-data
/data/
runs/
*.bin
*.mp4

# site: the published page needs its own video and binary scan files
!docs/media/*.mp4
!docs/data/*.bin
# drafts, agent workspaces and screen recordings stay local
.claude/
docs/next/
results/site_shots/
results/*.mp4
README.draft.md
notes/TASTE.md
notes/LESSONS.md
notes/redesign-*.md
notes/site-references*.md
notes/part2-post.md
notes/part2-script-and-post.md
notes/headline-zlock.md
notes/readme-additions.md

# the live page (the Nov 24 build) loads every spot's camera and lidar webp from route.json; the jpg copies stay local
docs/media/spots/*.jpg
# scroll recordings and large renders
*.webm
results/*_2160.png
results/*_2160.mp4
# redesign reference notes stay local
notes/site-scroll-references.md
# large render stills from the reel work stay local; the README copies live in docs/media
results/part2_*.png
results/readme_result.png
# local ship notes and the scan version poster (not used by the live page)
notes/push-list-*.txt
docs/scan_poster.webp
